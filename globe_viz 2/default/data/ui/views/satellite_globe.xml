<form version="1.1" theme="dark">
  <label>Satellite Globe</label>
  <description>Interactive 3D globe: satellites classified by orbit regime (LEO / MEO / GEO / HEO) plus ground sites. Sample data from the bundled lookups.</description>
  <fieldset submitButton="false" autoRun="true">
    <input type="dropdown" token="clsfilter" searchWhenChanged="true">
      <label>Orbit class filter</label>
      <!-- value holds an optional trailing search clause; empty = show everything -->
      <choice value="">All objects</choice>
      <choice value="| search orbit_class=LEO">LEO only</choice>
      <choice value="| search orbit_class=MEO">MEO only</choice>
      <choice value="| search orbit_class=GEO">GEO only</choice>
      <choice value="| search orbit_class=HEO">HEO only</choice>
      <choice value="| search orbit_class=Ground">Ground only</choice>
      <default></default>
      <initialValue></initialValue>
    </input>
  </fieldset>
  <row>
    <panel>
      <title>Orbit regimes + ground sites on an interactive globe</title>
      <viz type="globe_viz.globe">
        <search>
          <query>| inputlookup satellites.csv | table name orbit_class tle1 tle2
| append [| inputlookup ground_stations.csv | table name orbit_class lat lon]
$clsfilter$</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="height">640</option>
        <option name="display.visualizations.custom.globe_viz.globe.colorByOrbitClass">true</option>
        <option name="display.visualizations.custom.globe_viz.globe.showLegend">true</option>
        <option name="display.visualizations.custom.globe_viz.globe.showOrbits">true</option>
        <option name="display.visualizations.custom.globe_viz.globe.showLabels">true</option>
        <option name="display.visualizations.custom.globe_viz.globe.enableLighting">true</option>
        <option name="display.visualizations.custom.globe_viz.globe.clockMultiplier">1</option>
        <option name="display.visualizations.custom.globe_viz.globe.orbitWindowHours">24</option>
        <option name="display.visualizations.custom.globe_viz.globe.showCities">true</option>
        <option name="display.visualizations.custom.globe_viz.globe.showConnections">true</option>
        <option name="display.visualizations.custom.globe_viz.globe.minElevationDeg">10</option>
        <option name="display.visualizations.custom.globe_viz.globe.connectionMode">both</option>
        <!-- Static links defined right in the command (A&gt;B, optional :status) -->
        <option name="display.visualizations.custom.globe_viz.globe.links">ISS (ZARYA)&gt;Svalbard (SvalSat):active, GALILEO&gt;Madrid DSN</option>
        <!-- Clicking an object sets tokens so the panels below react. -->
        <drilldown>
          <set token="sel">$click.value$</set>
          <set token="selName">$row.name$</set>
          <set token="selClass">$row.orbit_class$</set>
        </drilldown>
      </viz>
    </panel>
  </row>
  <row depends="$sel$">
    <panel>
      <title>Selected: $selName$</title>
      <table>
        <search>
          <query>| inputlookup satellites.csv
| append [| inputlookup ground_stations.csv]
| search name="$sel$"
| table name orbit_class tle1 tle2 lat lon</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Objects by orbit class</title>
      <chart>
        <search>
          <query>| inputlookup satellites.csv | table name orbit_class
| append [| inputlookup ground_stations.csv | table name orbit_class]
| stats count by orbit_class | rename orbit_class as "Orbit class", count as "Objects"</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.legend.placement">none</option>
        <option name="height">260</option>
      </chart>
    </panel>
    <panel>
      <title>Catalog</title>
      <table>
        <search>
          <query>| inputlookup satellites.csv | table name orbit_class
| append [| inputlookup ground_stations.csv | eval note="ground site" | table name orbit_class note]
| fillnull value="satellite (TLE)" note
| rename name as "Object", orbit_class as "Class", note as "Type"</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="count">20</option>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>
</form>
